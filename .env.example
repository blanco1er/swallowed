# Copy to .env and fill in. Never commit .env.
# Gemini key for photo and free-text recognition (https://aistudio.google.com/apikey).
# Without it the app runs in demo mode: typing and saying known items still work.
GEMINI_API_KEY=
# Optional
# GEMINI_MODEL=gemini-3.8-flash
# IDENTIFY_PER_IP_PER_DAY=40
# PORT=3000
